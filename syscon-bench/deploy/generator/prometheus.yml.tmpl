# Generated by the generator scripts. __CH_HOST__ is the Tailscale host.
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: dashboard
    metrics_path: /metrics
    static_configs:
      - targets: ["dashboard:8001"]

  - job_name: vector
    static_configs:
      - targets: ["vector:9598"]

  - job_name: clickhouse
    static_configs:
      - targets: ["__CH_HOST__:9363"]
